FROM postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
# The service starts as postgres. Its entrypoint never needs a root step-down
# helper; remove the unused binary and its vulnerable bundled Go runtime.
RUN rm /usr/local/bin/gosu
USER postgres:postgres
